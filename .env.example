# Leave disabled to run the existing creator site without a database.
# Production values and first-deploy checklist: docs/render-deployment.md
LEVEL38_ENABLED=false
# Local only: let Render supply PORT in production (do not upload this file).
PORT=3000
NODE_ENV=development

# PostgreSQL connection string. Supply your own credentials; URL-encode special characters.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/level38?schema=public
# Exact browser origin, without a trailing slash. HTTPS is required in production.
LEVEL38_ORIGIN=http://localhost:3000
# 0 locally; 1 behind Render's single trusted reverse proxy. Never use unrestricted trust.
LEVEL38_TRUST_PROXY_HOPS=0

# Render selects Node 24 from .node-version. NODE_VERSION is an optional platform
# override; remove an old conflicting override before deploying.
# LEVEL38_TEST_DATABASE_URL is only for disposable integration-test databases;
# never configure it on the production service.
