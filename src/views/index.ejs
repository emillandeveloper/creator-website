<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= profile.displayName %> — <%= profile.lairName[lang] %></title>
  <meta name="description" content="<%= profile.bio[lang] %>">
  <link rel="icon" type="image/png" href="<%= profile.logoStatic %>">
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Press+Start+2P&display=swap" rel="stylesheet">
</head>
<body style="--banner: url('<%= profile.banner %>')">

  <!-- ===================== LANG TOGGLE ===================== -->
  <div class="lang-toggle">
    <a href="?lang=en" class="<%= lang === 'en' ? 'active' : '' %>">EN</a>
    <span>/</span>
    <a href="?lang=es" class="<%= lang === 'es' ? 'active' : '' %>">ES</a>
  </div>

  <!-- ===================== HERO / BANNER ===================== -->
  <header class="hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1 class="hero-title">Leo Nifelheim</h1>
      <p class="hero-tagline"><%= profile.tagline[lang] %></p>
      <div class="hero-langs">
        <span><%= profile.languages %></span>
        <span class="divider">◆</span>
        <span><%= timeZoneLabel %></span>
      </div>
      <div class="stream-spotlight" id="stream-spotlight" data-mode="<%= spotlight.mode %>">
        <div class="stream-copy" role="status" aria-live="polite" aria-atomic="true">
          <p class="stream-label" data-stream-label><%= spotlight.label %></p>
          <p class="stream-game" data-stream-game><%= spotlight.game %></p>
          <p class="stream-detail" data-stream-detail><%= spotlight.detail %></p>
        </div>
        <a class="action-link twitch-link" data-stream-link href="<%= twitchUrl %>" target="_blank" rel="noopener"><%= spotlight.linkLabel %></a>
      </div>
    </div>
  </header>

  <!-- ===================== NAV ===================== -->
  <nav class="nav">
    <button class="nav-btn active" data-slide="0"><%= ui.navSchedule[lang] %></button>
    <button class="nav-btn" data-slide="1"><%= ui.navAbout[lang] %></button>
    <button class="nav-btn" data-slide="2"><%= ui.navNowPlaying[lang] %></button>
    <button class="nav-btn" data-slide="3"><%= ui.navChallenges[lang] %></button>
    <button class="nav-btn" data-slide="4"><%= ui.navPlaythroughs[lang] %></button>
    <button class="nav-btn" data-slide="5"><%= ui.navSocials[lang] %></button>
  </nav>

  <!-- ===================== SLIDER ===================== -->
  <div class="slider-viewport">
    <div class="slider-track" id="track">

      <!-- SLIDE 0: HORARIO -->
      <section class="slide" id="slide-schedule" data-section="schedule">
        <div class="slide-inner">
          <h2 class="section-title"><%= ui.schedTitle[lang] %></h2>
          <div class="schedule-list">
            <% schedule.forEach(function(day, i) { %>
              <div class="day-row <%= (i === todayIndex) ? 'today' : '' %>"
                   style="--cat-color: <%= catColors[day.category] %>">
                <div class="day-badge"><%= catLabels[day.category] %></div>
                <div class="day-info">
                  <span class="day-name"><%= day.name[lang] %></span>
                  <span class="day-sub"><%= day.subtitle[lang] %></span>
                </div>
                <div class="day-logo">
                  <img
                    src="<%= day.logo %>"
                    alt="<%= day.game %>"
                    class="<%= day.logoOutline === true ? 'logo-outline' : '' %>"
                    style="transform: scale(<%= day.logoScale ?? 1 %>);"
                    onerror="this.style.display='none'"
                  >
                </div>
                <div class="day-time">
                  <span><%= day.timeStart %></span>
                  <span class="time-sep">—</span>
                  <span><%= day.timeEnd %></span>
                </div>
              </div>
            <% }); %>
          </div>
          <p class="schedule-note"><%= ui.schedNote[lang] %> · <%= timeZoneLabel %></p>
        </div>
      </section>

      <!-- SLIDE 1: SOBRE MÍ -->
      <section class="slide" id="slide-about" data-section="about">
        <div class="slide-inner">
          <h2 class="section-title"><%= ui.aboutTitle[lang] %></h2>
          <div class="about-card">
            <img src="<%= profile.mascot %>" alt="Jotun" class="about-mascot" onerror="this.style.display='none'">
            <div class="about-copy">
              <% profile.about.forEach(function(paragraph) { %>
                <p><%= paragraph[lang] %></p>
              <% }); %>
            </div>
          </div>
        </div>
      </section>

      <!-- SLIDE 2: NOW PLAYING -->
      <section class="slide" id="slide-now-playing" data-section="now-playing">
        <div class="slide-inner">
          <h2 class="section-title"><%= ui.nowPlayingTitle[lang] %></h2>
          <%- include('partials/game-grid', { games: nowPlayingGames, showType: true }) %>
        </div>
      </section>

      <!-- SLIDES 3–4: CHALLENGES / PLAYTHROUGHS -->
      <% const collections = [
        { id: 'challenges', title: ui.challengesTitle, intro: ui.challengesIntro, games: challengeGames, empty: ui.noChallenges },
        { id: 'playthroughs', title: ui.playthroughsTitle, intro: ui.playthroughsIntro, games: playthroughGames, empty: ui.noPlaythroughs }
      ]; %>
      <% collections.forEach(function(collection) { %>
        <section class="slide" id="slide-<%= collection.id %>" data-section="<%= collection.id %>" data-catalog>
          <div class="slide-inner">
            <h2 class="section-title"><%= collection.title[lang] %></h2>
            <p class="section-intro"><%= collection.intro[lang] %></p>
            <div class="catalog-toolbar">
              <div class="catalog-search-field"><label for="search-<%= collection.id %>"><%= lang === 'es' ? 'Buscar juego' : 'Search games' %></label>
                <input id="search-<%= collection.id %>" type="search" data-catalog-search placeholder="<%= lang === 'es' ? 'Nombre o descripción…' : 'Name or description…' %>" autocomplete="off"></div>
              <div><label for="status-<%= collection.id %>"><%= lang === 'es' ? 'Estado' : 'Status' %></label>
                <select id="status-<%= collection.id %>" data-catalog-status><option value="all"><%= lang === 'es' ? 'Todos' : 'All' %></option><option value="playing"><%= ui.statusPlaying[lang] %></option><option value="completed"><%= ui.statusCompleted[lang] %></option></select></div>
              <p class="catalog-count" data-catalog-count role="status" aria-live="polite"></p>
            </div>
            <p class="search-empty" data-catalog-empty hidden><%= lang === 'es' ? 'No hay juegos que coincidan con tu búsqueda.' : 'No games match your search.' %></p>
            <% if (collection.games.length === 0) { %>
              <p class="empty-state"><%= collection.empty[lang] %></p>
            <% } %>
            <% ['playing', 'completed'].forEach(function(status) {
              const games = collection.games.filter(function(game) { return game.status === status; });
              if (games.length === 0) return;
              const headingId = collection.id + '-' + status;
            %>
              <section class="game-group" aria-labelledby="<%= headingId %>">
                <h3 class="game-group-title" id="<%= headingId %>"><%= (status === 'playing' ? ui.inProgressTitle : ui.completedTitle)[lang] %> · <%= games.length %></h3>
                <%- include('partials/game-grid', { games: games, showType: false }) %>
              </section>
            <% }); %>
          </div>
        </section>
      <% }); %>

      <!-- SLIDE 5: REDES -->
      <section class="slide" id="slide-socials" data-section="socials">
        <div class="slide-inner">
          <h2 class="section-title"><%= ui.socialTitle[lang] %></h2>
          <div class="socials-row">
            <% socials.forEach(function(s) { %>
              <a href="<%= s.url %>" target="_blank" rel="noopener"
                 class="social-btn" style="--social-color: <%= s.color %>">
                <span class="social-name"><%= s.name %></span>
              </a>
            <% }); %>
          </div>
        </div>
      </section>

    </div>
  </div>

  <footer class="footer">
    <img src="<%= profile.logoStatic %>" alt="" class="footer-logo" onerror="this.style.display='none'">
    <p>© <%= new Date().getFullYear() %> <%= profile.displayName %> · <%= ui.footer[lang] %></p>
    <p style="margin-top:0.6rem;"><a href="/portfolio" style="color:var(--text-faint);text-decoration:none;border-bottom:1px solid var(--border-glow);">Dev Portfolio →</a></p>
    <%- include('partials/admin-link') %>
  </footer>

  <script src="/js/slider.js"></script>
  <script src="/js/catalog-search.js"></script>
  <script src="/js/stream-status.js"></script>
</body>
</html>
