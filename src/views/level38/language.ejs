<div class="l38-language" role="group" data-i18n-aria-label="Language" aria-label="<%= t('Language') %>">
  <button type="button" data-language="es" lang="es" aria-pressed="<%= lang === 'es' %>" data-i18n-aria-label="Spanish" aria-label="<%= t('Spanish') %>">ES</button>
  <span aria-hidden="true">|</span>
  <button type="button" data-language="en" lang="en" aria-pressed="<%= lang === 'en' %>" data-i18n-aria-label="English" aria-label="<%= t('English') %>">EN</button>
</div>
