<!DOCTYPE html>
<html lang="<%= overlayLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>LEVEL 38 · Poll overlay</title>
  <link rel="stylesheet" href="/css/level38-overlays.css">
  <script defer src="/js/level38/translations.js"></script>
  <script defer src="/level38/socket.io/socket.io.js"></script>
  <script defer src="/js/level38/overlays.js"></script>
</head>
<body class="l38-obs" data-overlay="poll" data-overlay-lang="<%= overlayLang %>">
  <main id="overlay-stage">
    <section id="poll-overlay" class="obs-panel obs-poll" hidden aria-live="polite" aria-atomic="false">
      <header class="obs-header"><span class="obs-brand">LEVEL <b>38</b></span><span id="poll-type" class="obs-eyebrow"></span><time id="poll-countdown" class="obs-countdown"></time></header>
      <div id="poll-live"><h1 id="poll-title"></h1><ol id="poll-options" class="obs-options"></ol><footer class="obs-vote"><span id="poll-cta"></span><strong>leonifelheim.tv/level38</strong><span id="poll-total"></span></footer></div>
      <div id="poll-result" class="obs-result" hidden><span class="obs-pixel-star" aria-hidden="true">✦</span><p id="poll-winner-label" class="obs-eyebrow"></p><h1 id="poll-winner"></h1><p id="poll-result-note"></p><span class="obs-pixel-star" aria-hidden="true">✦</span></div>
    </section>
  </main>
</body>
</html>
