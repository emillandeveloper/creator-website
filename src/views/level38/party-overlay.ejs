<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>LEVEL 38 Party</title>
  <link rel="stylesheet" href="/css/level38-party.css">
  <script defer src="/level38/socket.io/socket.io.js"></script>
  <script defer src="/js/level38/sprites.js"></script>
  <script defer src="/js/level38/party-fireworks.js"></script>
  <script defer src="/js/level38/party-overlay.js"></script>
</head>
<body data-preview="<%= preview %>">
  <main id="party-stage" aria-label="LEVEL 38 party"></main>
  <span id="party-overflow" hidden></span>
  <canvas id="party-fireworks" aria-hidden="true" hidden></canvas>
  <section id="party-celebration" role="status" hidden><span>LEVEL 38!</span><strong><%= t('ADVENTURE COMPLETE') %></strong></section>
  <% if (preview) { %>
  <div id="party-preview-controls">
    <span><%= t('OWNER PREVIEW') %> · <%= preview %></span>
    <button id="preview-vote" type="button"><%= t('Vote hop') %></button>
    <button id="preview-victory" type="button"><%= t('Party victory') %></button>
    <button id="preview-finale" type="button"><%= t('Preview LEVEL 38 fireworks') %></button>
    <label><%= t('Nickname display') %> <select id="preview-names"><option value="ALWAYS"><%= t('Names always') %></option><option value="ENTRY"><%= t('Names on entry') %></option><option value="OFF"><%= t('Names off') %></option></select></label>
  </div>
  <% } %>
</body>
</html>
